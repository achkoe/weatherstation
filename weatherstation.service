[Unit]
Description=Read and archive data from a Bresser weather station
After=rtl_433-mqtt.service

[Service]
User=root
WorkingDirectory=/home/pi/weatherstation
ExecStart=/usr/bin/bash -c 'cd /home/pi/weatherstation/ && source /home/pi/weatherstation/.venv/bin/activate && python write_database.py'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target